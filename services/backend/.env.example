# ---------------------------------------------------------------------------
# Beehive hornet-defense backend — example environment
#
# Every value below has a working default. Copy this file to .env only when
# you want to change something; the server runs with no .env at all.
# ---------------------------------------------------------------------------

# --- AI adapters -----------------------------------------------------------
# mock = no model files needed (default, and what the demo runs on)
# yolo = requires YOLO_MODEL_PATH and `pip install -r requirements-ai.txt`
DETECTOR_MODE=mock
YOLO_MODEL_PATH=
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_HORNET_CLASSES=hornet,wasp,vespa

# mock = no audio model needed (default)
# librosa = requires AUDIO_MODEL_PATH and `pip install -r requirements-ai.txt`
AUDIO_MODEL_MODE=mock
AUDIO_MODEL_PATH=

# console = print the notification (default, no Firebase needed)
# firebase = real FCM; requires FIREBASE_CREDENTIALS_PATH
NOTIFICATION_MODE=console
FIREBASE_CREDENTIALS_PATH=

# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///./beehive.db
SEED_ON_STARTUP=true
# Absolute base URL used to build snapshot links returned to the phone.
# Leave empty for relative URLs; set it when the app is on another device.
# PUBLIC_BASE_URL=http://192.168.0.10:8000

# --- Risk Engine: analysis window -----------------------------------------
RISK_WINDOW_SECONDS=30
AUDIO_FRESHNESS_SECONDS=20

# --- Risk Engine: component weights (should sum to 1.0) -------------------
WEIGHT_VISUAL_COUNT=0.40
WEIGHT_PERSISTENCE=0.25
WEIGHT_GROWTH=0.20
WEIGHT_AUDIO=0.15

# --- Risk Engine: normalisation -------------------------------------------
COUNT_SATURATION=6
RECENT_MAX_BLEND=0.35
GROWTH_SATURATION=0.30
PERSISTENCE_MIN_FRAMES=3

# --- Risk Engine: status thresholds ---------------------------------------
# NOTE: these are MVP validation heuristics, not scientifically validated
# criteria for a real hornet mass attack. See README.
CAUTION_THRESHOLD=35
DANGER_THRESHOLD=65

# --- Device liveness -------------------------------------------------------
OFFLINE_AFTER_SECONDS=45
HEARTBEAT_INTERVAL_SECONDS=10

# --- Device pairing --------------------------------------------------------
# How long a pairing code stays claimable (seconds).
PAIRING_TTL_SECONDS=600
PAIRING_CODE_DIGITS=6
# Claim attempts allowed per client inside the window. Six digits is only a
# million possibilities, so the claim endpoint has to be throttled.
PAIRING_CLAIM_MAX_ATTEMPTS=10
PAIRING_CLAIM_WINDOW_SECONDS=300
# Claimed/expired codes older than this are swept when a new code is issued.
PAIRING_RETENTION_SECONDS=86400

# --- Alert de-duplication --------------------------------------------------
ALERT_COOLDOWN_SECONDS=60
ALERT_RECOVERY_SECONDS=120
ALERT_ON_CAUTION=true
