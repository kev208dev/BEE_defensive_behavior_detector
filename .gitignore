# --- AI model weights (large, and never committed) ---
# Scoped to a leading slash so it cannot swallow lib/core/models/ in the app.
*.pt
*.onnx
*.joblib
*.pkl
/models/
services/backend/models/

# --- Firebase credentials (never commit these) ---
google-services.json
GoogleService-Info.plist
firebase-service-account*.json
**/firebase_options.dart

